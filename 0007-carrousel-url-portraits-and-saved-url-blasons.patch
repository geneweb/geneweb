From bc507a0311c7612b468792159f1d850d62a072f0 Mon Sep 17 00:00:00 2001
From: hgouraud <gouraud.henri@gmail.com>
Date: Sun, 1 Nov 2026 15:31:54 +0100
Subject: [PATCH] carrousel: url portraits and saved url blasons

- get_old_blason_name gave saved/x.blason.url for an url blason, so the
  carrousel showed saved/saved/... and its delete link missed the file.
- PORTRAIT_TO_BLASON with an url in the image field writes the blason
  .url directly instead of creating a portrait .url file beside the
  field.
- An url of the image field has no file: the carrousel shows the url and
  a link to MOD_IND instead of an empty name and a delete link that
  fails.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011mHfVhTFVxSeUnkepSDrsm
---
 hd/etc/carrousel.txt  | 25 +++++++++++++++----------
 lib/image.ml          |  2 +-
 lib/imageCarrousel.ml | 26 ++++++++++----------------
 3 files changed, 26 insertions(+), 27 deletions(-)

diff --git a/hd/etc/carrousel.txt b/hd/etc/carrousel.txt
index 4b9408b..10e3991 100644
--- a/hd/etc/carrousel.txt
+++ b/hd/etc/carrousel.txt
@@ -235,14 +235,20 @@
             <a href="%prefix;m=PORTRAIT_MOVE_TO_BLASON&i=%index;" class="mx-1"
                title="[*move portrait to blason]">
               <i class="fa fa-shield-halved"></i></a>
-            %if;has_portrait_url;%portrait_name;%else;
-            <strong><samp class="text-truncate">%portraits_store;%X;</samp></strong><samp>%portrait_name;</samp>%end;
-            <a role="button" class="ms-auto"
-              href="%prefix;m=DEL_IMAGE_C_OK&i=%index;&mode=portraits&file_name=%portrait_name;"
-              data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="left"
-              title="<i class='far fa-trash-can text-warning me-1'></i><strong>[*delete portrait]</strong><br><span class='small'>%portrait;</span><br>
-                <img class='rounded my-1' src='%portrait_url;' width='185px'>">
-              <i class="far fa-trash-can text-warning me-1"></i>%nn;</a>
+            %if;(portrait_name="")
+              %( url of the image field: no file, MOD_IND changes it %)
+              <samp class="text-truncate">%portrait;</samp>
+              <a role="button" class="ms-auto" href="%prefix;m=MOD_IND&i=%index;"
+                title="[*modify]"><i class="far fa-pen-to-square text-primary me-1"></i>%nn;</a>
+            %else;
+              <strong><samp class="text-truncate">%portraits_store;%X;</samp></strong><samp>%portrait_name;</samp>
+              <a role="button" class="ms-auto"
+                href="%prefix;m=DEL_IMAGE_C_OK&i=%index;&mode=portraits&file_name=%portrait_name;"
+                data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="left"
+                title="<i class='far fa-trash-can text-warning me-1'></i><strong>[*delete portrait]</strong><br><span class='small'>%portrait;</span><br>
+                  <img class='rounded my-1' src='%portrait_url;' width='185px'>">
+                <i class="far fa-trash-can text-warning me-1"></i>%nn;</a>
+            %end;
           </div>
         %end;
         %if;has_old_portrait;
@@ -256,8 +262,7 @@
             <a role="button" href="%prefix;m=RESET_IMAGE_C_OK&i=%index;&mode=portraits&file_name=%portrait;"
               title="[*restore portrait saved]">
               <i class="fa fa-retweet fa-rotate-90 fa-fw text-success"></i>%nn;</a>
-            %if;has_old_portrait_url;<strong><samp class="text-truncate">%old_portraits_store;%X;</samp></strong>%old_portrait_name;%else;
-            <strong><samp class="text-truncate">%old_portraits_store;%X;</samp></strong><samp>%old_portrait_name;</samp>%end;
+            <strong><samp class="text-truncate">%old_portraits_store;%X;</samp></strong><samp>%old_portrait_name;</samp>
             <a role="button" class="ms-auto"
               href="%prefix;m=DEL_IMAGE_C_OK&i=%index;&mode=portraits&delete=on&file_name=%old_portrait_name;"
               data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="left"
diff --git a/lib/image.ml b/lib/image.ml
index e636421..856064d 100644
--- a/lib/image.ml
+++ b/lib/image.ml
@@ -343,7 +343,7 @@ let get_blason_name_aux conf base p saved =
   let f = Filename.concat (portrait_folder conf) name in
   match find_img_opt f with
   | Some (`Path p) -> Filename.basename p
-  | Some (`Url _u) -> name ^ ".url"
+  | Some (`Url _u) -> Filename.basename name ^ ".url"
   | None -> ""
 
 let get_blason_name conf base p = get_blason_name_aux conf base p false
diff --git a/lib/imageCarrousel.ml b/lib/imageCarrousel.ml
index 212d8c7..c5b3cd6 100644
--- a/lib/imageCarrousel.ml
+++ b/lib/imageCarrousel.ml
@@ -618,24 +618,15 @@ let effective_copy_portrait_to_blason conf base p =
   in
   let keydir = Image.default_image_filename "portraits" base p in
   let dir = !GWPARAM.portraits_d conf.bname in
-  let create_url_file keydir url =
-    let fname = Filename.concat dir (keydir ^ ".url") in
-    let oc = Secure.open_out_bin fname in
-    output_string oc url;
-    flush oc;
-    close_out oc;
-    fname
-  in
-  let fname, url =
+  let field_url =
     match Image.src_of_string conf (Driver.sou base (Driver.get_image p)) with
-    | `Url u -> (create_url_file keydir u, true)
-    | _ -> (Image.default_image_filename "portraits" base p, false)
+    | `Url u -> Some u
+    | `Empty | `Path _ | `Src_with_size_info _ -> None
   in
   let ext =
-    if url then ".url" else get_extension conf keydir mode false fname
-  in
-  let portrait_filename =
-    String.concat Filename.dir_sep [ dir; keydir ^ ext ]
+    match field_url with
+    | Some _ -> ".url"
+    | None -> get_extension conf keydir mode false keydir
   in
   let blason_filename =
     String.concat Filename.dir_sep
@@ -651,7 +642,10 @@ let effective_copy_portrait_to_blason conf base p =
      else "OK")
     <> ""
   in
-  cp portrait_filename blason_filename;
+  (match field_url with
+  | Some u -> write_file blason_filename u
+  | None ->
+      cp (String.concat Filename.dir_sep [ dir; keydir ^ ext ]) blason_filename);
   History.record conf base
     (U_Send_image (Util.string_gen_person base (Driver.gen_person_of_person p)))
     "cb";
-- 
