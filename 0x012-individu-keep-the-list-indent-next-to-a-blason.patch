From 66e15127b434e2788abcd640ebb56a55d380f8f1 Mon Sep 17 00:00:00 2001
From: hgouraud <gouraud.henri@gmail.com>
Date: Mon, 2 Nov 2026 18:54:05 +0100
Subject: [PATCH] individu: keep the list indent next to a blason

The civil status list dropped its left padding (ps-0) when the person
had no image, even when the blason was displayed in place of the
portrait: the bullets then touched the blason.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011mHfVhTFVxSeUnkepSDrsm
---
 hd/etc/modules/individu.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hd/etc/modules/individu.txt b/hd/etc/modules/individu.txt
index 379ba67..d97f810 100644
--- a/hd/etc/modules/individu.txt
+++ b/hd/etc/modules/individu.txt
@@ -219,7 +219,7 @@
   %end;
 %end;
 %define;etat_civil()
-  <ul class="%if;not roglo;fa-ul%end;%if;(not (has_image or b.default_image="yes")) ps-0%end; mb-0">
+  <ul class="%if;not roglo;fa-ul%end;%if;(not (has_image or has_blason or b.default_image="yes")) ps-0%end; mb-0">
     %if;(has_birth_date or has_birth_place)
       <li %apply;getvar%with;ns[birth]%end;>
         %if;(not roglo)<span class="fa-li"><i class="fas fa-baby"></i></span>%end;
-- 
2.43.0

