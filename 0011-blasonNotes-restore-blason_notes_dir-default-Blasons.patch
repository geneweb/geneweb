From cc913f018a83cbc79a99f311d1ef6d1317e7a004 Mon Sep 17 00:00:00 2001
From: hgouraud <gouraud.henri@gmail.com>
Date: Sun, 1 Nov 2026 15:50:08 +0100
Subject: [PATCH] blasonNotes: restore blason_notes_dir (default Blasons)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011mHfVhTFVxSeUnkepSDrsm
---
 etc/a.gwf          |  5 ++++-
 lib/blasonNotes.ml | 12 ++++++++----
 2 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/etc/a.gwf b/etc/a.gwf
index 540cbf4..1876a9d 100644
--- a/etc/a.gwf
+++ b/etc/a.gwf
@@ -156,9 +156,12 @@
 
 # In the carrousel, turn the portrait into the blason in one step: the
 # portrait is copied to the blason and moved to saved, and its m=IM
-# references in the misc notes Blasons (Blasons.txt and the Blasons folder)
+# references in the blason misc notes (see blason_notes_dir below)
 # become m=FIM references (or the url of an url portrait).
 #direct_portrait_to_blason=yes
+# Misc notes holding the blason pages for direct_portrait_to_blason:
+# <name>.txt and the folder <name> (default: Blasons). Empty: no notes update.
+#blason_notes_dir=Blasons
 
 # Set a maximum images size in bytes which can be accepted in “send image”
 #max_images_size=
diff --git a/lib/blasonNotes.ml b/lib/blasonNotes.ml
index 9e7c451..684d46c 100644
--- a/lib/blasonNotes.ml
+++ b/lib/blasonNotes.ml
@@ -1,5 +1,5 @@
 (* Redirect references to a person's portrait (m=IM) towards his blason in
-   the misc notes Blasons (Blasons.txt and the Blasons folder), once the
+   the blason misc notes (Blasons.txt and the Blasons folder), once the
    portrait has been turned into the blason. The blason pages reference a
    blason file with m=FIM and an url blason with the url itself. *)
 
@@ -11,8 +11,12 @@ module Log = (val Logs.src_log src : Logs.LOG)
 
 type target = Fim | Url of string
 
-(* Misc notes holding the blason pages: Blasons.txt and/or Blasons/... *)
-let notes_dir = "Blasons"
+(* Misc notes holding the blason pages: <dir>.txt and/or the folder <dir>,
+   Blasons by default; [blason_notes_dir=] in the .gwf disables the scan. *)
+let notes_dir conf =
+  match List.assoc_opt "blason_notes_dir" conf.Config.base_env with
+  | Some d -> String.trim d
+  | None -> "Blasons"
 
 (* Misc notes names of the page [dir] ("Blasons") and of all the .txt files
    below the folder [dir] ("Blasons:pages:A:m"). *)
@@ -187,7 +191,7 @@ let redirect_portrait_refs conf base p target =
   let root =
     Filename.concat (Util.bpath conf.Config.bname) (Driver.base_notes_dir base)
   in
-  let dir = notes_dir in
+  let dir = notes_dir conf in
   let files =
     if usable_target target then fnotes_below root dir else []
   in
-- 
2.43.0

