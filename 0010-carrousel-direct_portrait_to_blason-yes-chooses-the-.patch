From f234a5b980de132e782b1bba3d8de354817ac1fe Mon Sep 17 00:00:00 2001
From: hgouraud <gouraud.henri@gmail.com>
Date: Sun, 1 Nov 2026 15:48:14 +0100
Subject: [PATCH] carrousel: direct_portrait_to_blason=yes chooses the one step
 method

The carrousel shows either the step by step PORTRAIT_TO_BLASON or, with
direct_portrait_to_blason=yes in the .gwf, PORTRAIT_MOVE_TO_BLASON, which
is refused otherwise. The misc notes scanned are always Blasons
(Blasons.txt and the Blasons folder): blason_notes_dir is dropped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011mHfVhTFVxSeUnkepSDrsm
---
 etc/a.gwf             |  6 ++++++
 hd/etc/carrousel.txt  | 17 +++++++++++------
 lib/blasonNotes.ml    | 14 ++++----------
 lib/imageCarrousel.ml | 16 +++++++++++-----
 4 files changed, 32 insertions(+), 21 deletions(-)

diff --git a/etc/a.gwf b/etc/a.gwf
index 51e378e..540cbf4 100644
--- a/etc/a.gwf
+++ b/etc/a.gwf
@@ -154,6 +154,12 @@
 # Don’t authorise wizards to send images.
 #can_send_image=no
 
+# In the carrousel, turn the portrait into the blason in one step: the
+# portrait is copied to the blason and moved to saved, and its m=IM
+# references in the misc notes Blasons (Blasons.txt and the Blasons folder)
+# become m=FIM references (or the url of an url portrait).
+#direct_portrait_to_blason=yes
+
 # Set a maximum images size in bytes which can be accepted in “send image”
 #max_images_size=
 
diff --git a/hd/etc/carrousel.txt b/hd/etc/carrousel.txt
index 10e3991..c0584aa 100644
--- a/hd/etc/carrousel.txt
+++ b/hd/etc/carrousel.txt
@@ -229,12 +229,17 @@
               title="<strong>[*see portrait]</strong><br><span class='small'>%portrait;</span><br>
                 <img class='rounded my-1' src='%portrait_url;' width='185px'>">
               <i class="far fa-file-image fa-fw text-primary"></i></a>
-            <a href="%prefix;m=PORTRAIT_TO_BLASON&i=%index;" class="mx-1"
-               title="[*copy portrait to blason]">
-              <i class="fa fa-user-shield"></i></a>
-            <a href="%prefix;m=PORTRAIT_MOVE_TO_BLASON&i=%index;" class="mx-1"
-               title="[*move portrait to blason]">
-              <i class="fa fa-shield-halved"></i></a>
+            %( direct_portrait_to_blason=yes: one step, the portrait goes to saved
+               and the Blasons notes are updated (Roglo) %)
+            %if;(b.direct_portrait_to_blason="yes")
+              <a href="%prefix;m=PORTRAIT_MOVE_TO_BLASON&i=%index;" class="mx-1"
+                 title="[*move portrait to blason]">
+                <i class="fa fa-shield-halved"></i></a>
+            %else;
+              <a href="%prefix;m=PORTRAIT_TO_BLASON&i=%index;" class="mx-1"
+                 title="[*copy portrait to blason]">
+                <i class="fa fa-user-shield"></i></a>
+            %end;
             %if;(portrait_name="")
               %( url of the image field: no file, MOD_IND changes it %)
               <samp class="text-truncate">%portrait;</samp>
diff --git a/lib/blasonNotes.ml b/lib/blasonNotes.ml
index 241c38a..9e7c451 100644
--- a/lib/blasonNotes.ml
+++ b/lib/blasonNotes.ml
@@ -1,5 +1,5 @@
 (* Redirect references to a person's portrait (m=IM) towards his blason in
-   the misc notes of a dedicated folder (e.g. Roglo's Blasons:...), once the
+   the misc notes Blasons (Blasons.txt and the Blasons folder), once the
    portrait has been turned into the blason. The blason pages reference a
    blason file with m=FIM and an url blason with the url itself. *)
 
@@ -11,14 +11,8 @@ module Log = (val Logs.src_log src : Logs.LOG)
 
 type target = Fim | Url of string
 
-let default_notes_dir = "Blasons"
-
-(* Notes folder scanned for portrait references; [blason_notes_dir=] in the
-   .gwf file disables the scan. *)
-let notes_dir conf =
-  match List.assoc_opt "blason_notes_dir" conf.Config.base_env with
-  | Some d -> String.trim d
-  | None -> default_notes_dir
+(* Misc notes holding the blason pages: Blasons.txt and/or Blasons/... *)
+let notes_dir = "Blasons"
 
 (* Misc notes names of the page [dir] ("Blasons") and of all the .txt files
    below the folder [dir] ("Blasons:pages:A:m"). *)
@@ -193,7 +187,7 @@ let redirect_portrait_refs conf base p target =
   let root =
     Filename.concat (Util.bpath conf.Config.bname) (Driver.base_notes_dir base)
   in
-  let dir = notes_dir conf in
+  let dir = notes_dir in
   let files =
     if usable_target target then fnotes_below root dir else []
   in
diff --git a/lib/imageCarrousel.ml b/lib/imageCarrousel.ml
index c5b3cd6..21f0b5e 100644
--- a/lib/imageCarrousel.ml
+++ b/lib/imageCarrousel.ml
@@ -831,11 +831,17 @@ let print_main_c conf base =
                       Filename.basename
                         (effective_copy_portrait_to_blason conf base p)
                   | "PORTRAIT_MOVE_TO_BLASON" ->
-                      let blason, notes =
-                        effective_move_portrait_to_blason conf base p
-                      in
-                      updated_notes := notes;
-                      Filename.basename blason
+                      if
+                        List.assoc_opt "direct_portrait_to_blason"
+                          conf.base_env
+                        = Some "yes"
+                      then (
+                        let blason, notes =
+                          effective_move_portrait_to_blason conf base p
+                        in
+                        updated_notes := notes;
+                        Filename.basename blason)
+                      else "error"
                   | "IMAGE_TO_BLASON" ->
                       Filename.basename
                         (effective_copy_image_to_blason conf base p)
-- 
2.43.0

