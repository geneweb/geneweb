From 03fd76dc5e881ec2e055a73e97e2950ef8f48b2b Mon Sep 17 00:00:00 2001
From: hgouraud <gouraud.henri@gmail.com>
Date: Sun, 1 Nov 2026 14:43:43 +0100
Subject: [PATCH 3/3] blasonNotes: an url portrait is referenced by its url

The blason pages reference a blason file with m=FIM and an url blason
with the url itself: when the moved portrait is an url, the m=IM
references are replaced by that url.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011mHfVhTFVxSeUnkepSDrsm
---
 lib/blasonNotes.ml    | 46 +++++++++++++++++++++++++++----------------
 lib/imageCarrousel.ml | 12 ++++++++---
 2 files changed, 38 insertions(+), 20 deletions(-)

diff --git a/lib/blasonNotes.ml b/lib/blasonNotes.ml
index 7a6f35d..677f445 100644
--- a/lib/blasonNotes.ml
+++ b/lib/blasonNotes.ml
@@ -1,6 +1,7 @@
-(* Redirect references to a person's portrait (m=IM) towards his blason
-   (m=FIM) in the misc notes of a dedicated folder (e.g. Roglo's Blasons:...),
-   once the portrait has been turned into the blason. *)
+(* Redirect references to a person's portrait (m=IM) towards his blason in
+   the misc notes of a dedicated folder (e.g. Roglo's Blasons:...), once the
+   portrait has been turned into the blason. The blason pages reference a
+   blason file with m=FIM and an url blason with the url itself. *)
 
 module Driver = Geneweb_db.Driver
 
@@ -8,6 +9,8 @@ let src = Logs.Src.create ~doc:"BlasonNotes" __MODULE__
 
 module Log = (val Logs.src_log src : Logs.LOG)
 
+type target = Fim | Url of string
+
 let default_notes_dir = "Blasons"
 
 (* Notes folder scanned for portrait references; [blason_notes_dir=] in the
@@ -114,21 +117,24 @@ let blason_key t =
   else k ^ ".blason" ^ String.sub t i (String.length t - i)
 
 (* Rewrites an attribute value if it is an m=IM url of [p]. *)
-let rewrite_value base p v =
+let rewrite_value base p target v =
   let tokens = split_query v in
   if List.exists is_im tokens && designates base p tokens then
-    Some
-      (String.concat ""
-         (List.map
-            (fun t ->
-              if is_im t then fim t
-              else if String.starts_with ~prefix:"k/" t then blason_key t
-              else t)
-            tokens))
+    match target with
+    | Url u -> Some u
+    | Fim ->
+        Some
+          (String.concat ""
+             (List.map
+                (fun t ->
+                  if is_im t then fim t
+                  else if String.starts_with ~prefix:"k/" t then blason_key t
+                  else t)
+                tokens))
   else None
 
 (* Scans the quoted attribute values (="..." or ='...') of [s]. *)
-let rewrite_text base p s =
+let rewrite_text base p target s =
   let len = String.length s in
   let b = Buffer.create (len + 64) in
   let rec loop i changed =
@@ -147,7 +153,7 @@ let rewrite_text base p s =
               changed
           | Some k -> (
               let v = String.sub s (j + 2) (k - j - 2) in
-              match rewrite_value base p v with
+              match rewrite_value base p target v with
               | Some v' ->
                   Buffer.add_string b v';
                   loop k true
@@ -166,7 +172,13 @@ let notes_path fnotes =
   | Some (dl, f) -> List.fold_right Filename.concat dl f
   | None -> fnotes
 
-let redirect_portrait_refs conf base p =
+(* An url replaces the whole attribute value: it must not close it. *)
+let usable_target target =
+  match target with
+  | Fim -> true
+  | Url u -> not (String.contains u '"' || String.contains u '\'')
+
+let redirect_portrait_refs conf base p target =
   let root =
     Filename.concat (Util.bpath conf.Config.bname) (Driver.base_notes_dir base)
   in
@@ -175,12 +187,12 @@ let redirect_portrait_refs conf base p =
       let s = Driver.base_notes_read base (notes_path fnotes) in
       if not (Mutil.contains s "m=IM") then acc
       else
-        match rewrite_text base p s with
+        match rewrite_text base p target s with
         | Some s' ->
             Log.info (fun k -> k "portrait -> blason in note %s" fnotes);
             Notes.commit_notes conf base fnotes s';
             fnotes :: acc
         | None -> acc)
     []
-    (fnotes_below root (notes_dir conf))
+    (if usable_target target then fnotes_below root (notes_dir conf) else [])
   |> List.rev
diff --git a/lib/imageCarrousel.ml b/lib/imageCarrousel.ml
index bbfea2e..212d8c7 100644
--- a/lib/imageCarrousel.ml
+++ b/lib/imageCarrousel.ml
@@ -659,14 +659,20 @@ let effective_copy_portrait_to_blason conf base p =
 
 (* The portrait becomes the blason: copy it, move the portrait to saved
    (unless it is an url of the image field, which only MOD_IND can clear) and
-   point the blason notes to the blason. Returns the blason file name and the
-   names of the updated notes. *)
+   point the blason notes to the blason (m=FIM, or the url itself for an url
+   portrait). Returns the blason file name and the names of the updated
+   notes. *)
 let effective_move_portrait_to_blason conf base p =
   let image_field_is_url =
     match Image.src_of_string conf (Driver.sou base (Driver.get_image p)) with
     | `Url _ -> true
     | `Empty | `Path _ | `Src_with_size_info _ -> false
   in
+  let target =
+    match Image.get_portrait conf base p with
+    | Some (`Url u) -> BlasonNotes.Url u
+    | Some (`Path _) | None -> BlasonNotes.Fim
+  in
   let blason_filename = effective_copy_portrait_to_blason conf base p in
   (if not image_field_is_url then
      let portrait =
@@ -674,7 +680,7 @@ let effective_move_portrait_to_blason conf base p =
        ^ Filename.extension blason_filename
      in
      ignore (effective_delete_c_ok conf base ~f_name:portrait p));
-  (blason_filename, BlasonNotes.redirect_portrait_refs conf base p)
+  (blason_filename, BlasonNotes.redirect_portrait_refs conf base p target)
 
 let effective_copy_image_to_blason conf base p =
   let fname =
